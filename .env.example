# Server Port (defaults to 3001 in dev, or assigned by cloud platform via $PORT)
PORT=3001

# Environment Mode: 'development' or 'production'
NODE_ENV=production

# JWT Authentication Secret Key (generate a strong random string in production)
JWT_SECRET=prepai_super_secret_jwt_key_2026

# Google Gemini API Key (Optional for live LLM inference; intelligent hybrid fallback engine is active if omitted)
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL Database Connection URL
# Local: postgresql://postgres:postgres@localhost:5432/prepai
# Cloud (Neon/Supabase/Render/Railway): postgresql://user:password@host:5432/dbname?sslmode=require
# If omitted, PrepAI runs in resilient in-memory mode automatically.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/prepai
